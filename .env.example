# Copy to .env for local-only values. Never commit secrets.
MINIDSH_LOG_LEVEL=INFO
MINIDSH_NETWORK_ENABLED=false
MINIDSH_MAX_STEPS=50
MINIDSH_TOOL_TIMEOUT_SECONDS=30

# --- Model provider -----------------------------------------------------------
# Select a named profile: deepseek | deepseek-reasoner | openai | ollama.
# MINIDSH_MODEL_PROFILE=deepseek
#
# The profile pins the endpoint, the model, and the credential variable. Any of
# them can be overridden per field:
# MINIDSH_MODEL=deepseek-chat
# MINIDSH_MODEL_ENDPOINT=https://api.deepseek.com/v1/chat/completions
#
# Credential: use the variable the profile declares, or point at a different one
# with `--api-key-env NAME`.
# DEEPSEEK_API_KEY=replace-locally-never-commit
# OPENAI_API_KEY=replace-locally-never-commit

# --- Cost accounting ----------------------------------------------------------
# A real provider refuses to run without a declared rate card: a zero rate is
# indistinguishable from an undeclared one, and reporting $0 for a paid model
# would silently corrupt every cost number in a report. Copy the current rates
# from the provider's pricing page before quoting anything.
# MINIDSH_INPUT_USD_PER_MILLION=0.0
# MINIDSH_OUTPUT_USD_PER_MILLION=0.0
# MINIDSH_CACHED_INPUT_USD_PER_MILLION=0.0

# --- Ad-hoc OpenAI-compatible endpoint (no profile) ---------------------------
# MINIDSH_MODEL_ENDPOINT=https://provider.example/v1/chat/completions
# MINIDSH_MODEL=example-model
# MINIDSH_API_KEY=replace-locally-never-commit
