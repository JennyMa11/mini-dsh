# Reference sheet for Mini-dsh's environment variables. NOT a file the runtime
# reads: nothing here is loaded automatically. Runtime settings resolve as
# CLI > environment > minidsh.toml > safe defaults; credentials have their own
# file-based layers (see below).
#
# Two ways to use it:
#
#   1. Copy the lines you need into your shell profile and edit them there.
#   2. Copy this file to .env and source it for one session:
#        cp .env.example .env
#        set -a; source .env; set +a
#
# .env is gitignored; .env.example is not. Never commit a real secret.

# --- Runtime -------------------------------------------------------------------
# All runtime fields use the MINIDSH_<FIELD> spelling; lists are JSON arrays.
# See docs/extensibility.md for the complete list.
MINIDSH_MAX_STEPS=50
MINIDSH_MAX_SECONDS=300
# MINIDSH_CONTEXT_STRATEGY=budget
# MINIDSH_ENABLED_TOOLS='["read_file","search"]'

# --- Model provider ------------------------------------------------------------
# Select a named profile: deepseek | deepseek-reasoner | openai | ollama.
# MINIDSH_MODEL_PROFILE=deepseek
#
# The profile pins the endpoint, the model, and the credential variable. Any of
# them can be overridden per field:
# MINIDSH_MODEL=deepseek-chat
# MINIDSH_MODEL_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# --- Credentials ---------------------------------------------------------------
# A credential is read from the variable named by its profile, with precedence:
# explicit environment > workspace .minidsh/credentials.toml > global
# ~/.config/minidsh/credentials.toml. Both files use a [credentials] table; the
# workspace file is written with mode 0600 by the runtime. `minidsh.toml` still
# rejects an inline api_key because that file is meant to be committed and shared.
#
# Per-profile variable names:
#   deepseek / deepseek-reasoner   DEEPSEEK_API_KEY
#   openai                         OPENAI_API_KEY
#   ollama                         none required
#   --endpoint without a profile   MINIDSH_API_KEY
#
# To point a profile at a differently named variable (e.g. one already in your
# shell profile), set MINIDSH_API_KEY_ENV, or pass --api-key-env NAME.
# DEEPSEEK_API_KEY=replace-locally-never-commit
# OPENAI_API_KEY=replace-locally-never-commit
# MINIDSH_API_KEY=replace-locally-never-commit
# MINIDSH_API_KEY_ENV=MY_OWN_VARIABLE_NAME
# MINIDSH_CONFIG_HOME=/absolute/path/to/minidsh-config

# --- Cost accounting -----------------------------------------------------------
# A real provider refuses to run without a declared rate card: a zero rate is
# indistinguishable from an undeclared one, and reporting $0 for a paid model
# would silently corrupt every cost number in a report. Copy the current rates
# from the provider's pricing page before quoting anything.
# MINIDSH_INPUT_USD_PER_MILLION=0.0
# MINIDSH_OUTPUT_USD_PER_MILLION=0.0
# MINIDSH_CACHED_INPUT_USD_PER_MILLION=0.0

# --- Ad-hoc OpenAI-compatible endpoint (no profile) ----------------------------
# MINIDSH_MODEL_ENDPOINT=https://provider.example/v1/chat/completions
# MINIDSH_MODEL=example-model
