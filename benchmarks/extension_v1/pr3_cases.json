  "container_probe_requirements": {
    "V01": {
      "expected": "real failed check, model repair, passed check; same run_id, monotonic steps; independent acceptance passes",
      "forbidden": "new run or reset budgets; hidden criteria exposed to the agent"
    },
    "V02": {
      "expected": "three actual checks, two feedbacks, final verification_failed when unchanged checks fail",
      "forbidden": "fourth check or third repair feedback"
    },
    "V03": {
      "variants": [
        "command_timeout",
        "cancel",
        "wall_clock_budget"
      ],
      "expected": "real child process was started; timeout/cancel stops all container processes; container removed; no subsequent model or tool action",
      "forbidden": "finished or surviving process/container"
    },
    "V04": {
      "expected": "fixed argv cannot be replaced in model arguments; actual check after changes; no cached pass",
      "forbidden": "unrelated/replaced command result is certified as verification passed"
    },
    "V05": {
      "variants": [
        "tampered_visible_test",
        "early_zero_exit"
      ],
      "expected": "runtime finished with visible pass may coexist with independent acceptance failure; independent evaluator deployed only after loop termination and bound to run_id in a separate sidecar",
      "forbidden": "independent labels/tests in model-visible workspace, request or context; runtime finished counted as task success"
    }
  },
  "container_budget": {
    "max_steps": 16,
    "max_tokens": 8000,
    "max_tool_calls": 32,
    "max_duration_seconds": 180
  },
  "component_budgets": "Fixed by each parametrized test source and retained per-run. Budget probes deliberately use lower individual limits; they are contract tests, not the six-task benchmark cohort.",
  "isolation": {
    "platform": "linux/arm64",
    "cpus": 1,
    "memory_mb": 1024,
    "network": "none",
    "host_mounts": false,
    "images": "reuse M0 frozen digest"
  },
  "offline_groups": [
    "Baseline",
    "A"
  ],
  "offline_manifest": "benchmarks/extension_v1/offline.json",
  "compatibility_normalization": {
    "ignored_identity_timing": [
      "run_id",
      "occurred_at",
      "duration_ms",
      "latency"
    ],
    "ignored_audit_events": [
      "extension_hook_completed",
      "finish_decided"
    ],
    "new_provenance_fields_ignored_only_in_historical_comparison": [
      "sources",
      "assembly_version"
    ],
    "must_equal": [
      "model requests",
      "tool actions",
      "tokens",
      "tool counts",
      "terminal results",
      "independent verifier results",
      "workspace artifacts"
    ]
  },
  "overhead_protocol": {
    "warmup": 20,
    "samples": 200,
    "batches": 3,
    "threshold_ms": 5,
    "relative_threshold": 0.1,
    "quantile": "nearest_rank",
    "aggregate": "median_p95_delta"
  },
  "exclusions": [
    "M01-M04/E03",
    "real_model_queue",
    "mechanism_benefit_claims"
  ],
